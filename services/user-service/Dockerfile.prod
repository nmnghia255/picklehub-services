# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies including devDependencies (needed for build)
RUN --mount=type=cache,id=global-npm-cache,sharing=locked,target=/root/.npm npm ci

# Copy source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Build application
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Copy node_modules from builder and prune devDependencies
# (avoids a second heavy npm ci under memory constraints)
COPY --from=builder /app/node_modules ./node_modules
RUN npm prune --production

# Copy built application
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dist-seed ./dist-seed
COPY --from=builder /app/prisma ./prisma

# Set node env to production
ENV NODE_ENV=production

# Expose port
EXPOSE 8006

# Run migrations and start app
CMD npx prisma migrate deploy && npm run seed:prod && node dist/main
