# Tournament service
PORT=8008
DATABASE_URL=postgresql://user:password@localhost:5439/tournamentdb

# Auth (incoming JWT verification)
JWT_ACCESS_SECRET=your-access-secret

# Inbound internal auth (other services calling tournament-service)
SERVICE_INTERNAL_TOKEN=your-super-secret-internal-service-token-change-this-in-production

# Outbound: match-service (fixture dispatch, result mirror)
MATCH_SERVICE_URL=http://localhost:8005

# Outbound: sport-center-service (courts, availability, bookings)
SPORT_CENTER_SERVICE_URL=http://localhost:8007

# Frontend URL
FRONTEND_URL=http://localhost:3000
