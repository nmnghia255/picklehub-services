// This is your Prisma schema file for Auth Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

/// Roles assigned to a user in the PickleHub platform
enum UserRole {
  USER
  ADMIN
}

/// Lifecycle status of a user account
enum UserStatus {
  PENDING      // Registered but email not yet verified
  ACTIVE       // Fully verified and active account
  DEACTIVATED  // Manually disabled by admin or user
  PENDING_DELETION // Requested account deletion, awaiting grace period
}

// ============================================
// Models
// ============================================

/// User account table
/// Stores credentials, profile info, social login IDs, role and status
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255) // nullable → supports social-only login
  name         String?    @map("name") @db.VarChar(255)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING)
  isActive     Boolean    @default(true) @map("is_active")
  isVerified   Boolean    @default(false) @map("is_verified")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  socialAccounts    SocialAccount[]

  @@map("users")
}

/// Refresh token storage for session management
/// Stores hashed refresh tokens to enable token validation and revocation
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Verification codes for email verification and password reset
/// Stores temporary codes/tokens with expiration
model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(255)
  type      String   @db.VarChar(50) // 'EMAIL_VERIFICATION' or 'PASSWORD_RESET'
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([type])
  @@map("verification_codes")
}

/// Social accounts linked to the user (e.g., Google, Facebook)
model SocialAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(50) // 'google', 'facebook', etc.
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}

