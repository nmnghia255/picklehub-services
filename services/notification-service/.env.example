# Local Development Environment Variables
# For running notification-service independently outside Docker

# Server Configuration
PORT=8002

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/notification-db?schema=public

# Email Configuration (Resend)
RESEND_API_KEY=re_123456789_your_resend_api_key_here
EMAIL_FROM=Picklehub <no-reply@picklehub.vn>

# Internal Service Authentication
SERVICE_INTERNAL_TOKEN=your-super-secret-internal-service-token-change-this-in-production

# Expo Push Notifications
# Optional but recommended for production security.
# Get from: https://expo.dev/settings/access-tokens (create a free Expo account first)
# Leave empty to allow unauthenticated push (fine for development, not recommended for prod)
EXPO_ACCESS_TOKEN=
