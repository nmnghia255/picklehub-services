# Service Ports
AUTH_SERVICE_PORT=8001
NOTIFICATION_SERVICE_PORT=8002
GROUP_SERVICE_PORT=8003
EVENT_SERVICE_PORT=8004
MATCH_SERVICE_PORT=8005
USER_SERVICE_PORT=8006
FRIEND_SERVICE_PORT=8010
SPORT_CENTER_SERVICE_PORT=8007
MEDIA_SERVICE_PORT=8011
API_GATEWAY_PORT=8080
REDIS_PORT=6379
REDIS_HOST=redis
TOURNAMENT_SERVICE_PORT=8008

# Auth Database Configuration
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=authpass
AUTH_DB_NAME=authdb
AUTH_DB_PORT=5432

# Auth Service - JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database URL for auth-service
AUTH_DATABASE_URL=postgresql://authuser:authpass@postgres-auth:5432/authdb?schema=public

# Notification Database Configuration
NOTIFICATION_DB_USER=notifuser
NOTIFICATION_DB_PASSWORD=notifpass
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_PORT=5433

# Database URL for notification-service
NOTIFICATION_DATABASE_URL=postgresql://notifuser:notifpass@postgres-notification:5432/notificationdb?schema=public

# Notification Service - Email Configuration (Resend)
# Base URL used by auth-service and group-service to call notification-service
NOTIFICATION_SERVICE_URL=http://notification-service:8002/api/notification

RESEND_API_KEY=re_123456789_your_resend_api_key_here
EMAIL_FROM=Picklehub <no-reply@picklehub.vn>

# Group Service Configuration
GROUP_DB_USER=groupuser
GROUP_DB_PASSWORD=grouppass
GROUP_DB_NAME=groupdb
GROUP_DB_PORT=5434

# Database URL for group-service
GROUP_DATABASE_URL=postgresql://groupuser:grouppass@postgres-group:5432/groupdb?schema=public

# Event Service Configuration
EVENT_DB_USER=eventuser
EVENT_DB_PASSWORD=eventpass
EVENT_DB_NAME=eventdb
EVENT_DB_PORT=5435

# Database URL for event-service
EVENT_DATABASE_URL=postgresql://eventuser:eventpass@postgres-event:5432/eventdb?schema=public

# Match Service Configuration
MATCH_DB_USER=matchuser
MATCH_DB_PASSWORD=matchpass
MATCH_DB_NAME=matchdb
MATCH_DB_PORT=5436

# Database URL for match-service
MATCH_DATABASE_URL=postgresql://matchuser:matchpass@postgres-match:5432/matchdb?schema=public

# Sport Center Service Configuration
SPORT_CENTER_DB_USER=sportcenteruser
SPORT_CENTER_DB_PASSWORD=sportcenterpass
SPORT_CENTER_DB_NAME=sportcenterdb
SPORT_CENTER_DB_PORT=5438

# Database URL for sport-center-service
SPORT_CENTER_DATABASE_URL=postgresql://sportcenteruser:sportcenterpass@postgres-sport-center:5432/sportcenterdb?schema=public

# User Service Configuration
USER_DB_USER=useruser
USER_DB_PASSWORD=userpass
USER_DB_NAME=userdb
USER_DB_PORT=5437
MAX_SPORT_CENTERS_PER_OWNER=10

# Database URL for user-service
USER_DATABASE_URL=postgresql://useruser:userpass@postgres-user:5432/userdb?schema=public

# Friend Service Configuration
FRIEND_DB_USER=frienduser
FRIEND_DB_PASSWORD=friendpass
FRIEND_DB_NAME=frienddb
FRIEND_DB_PORT=5441

# Database URL for friend-service
FRIEND_DATABASE_URL=postgresql://frienduser:friendpass@postgres-friend:5432/frienddb?schema=public

# Tournament Database Configuration
TOURNAMENT_DB_USER=tournamentuser
TOURNAMENT_DB_PASSWORD=tournamentpass
TOURNAMENT_DB_NAME=tournamentdb
TOURNAMENT_DB_PORT=5439

# Database URL for tournament-service
TOURNAMENT_DATABASE_URL=postgresql://tournamentuser:tournamentpass@postgres-tournament:5432/tournamentdb?schema=public

# Inter-Service URLs and Tokens
GROUP_SERVICE_URL=http://group-service:8003
AUTH_SERVICE_URL=http://auth-service:8001
EVENT_SERVICE_URL=http://event-service:8004
MATCH_SERVICE_URL=http://match-service:8005
USER_SERVICE_URL=http://user-service:8006
SPORT_CENTER_SERVICE_URL=http://sport-center-service:8007
FRIEND_SERVICE_URL=http://friend-service:8010
MEDIA_SERVICE_URL=http://media-service:8011
TOURNAMENT_SERVICE_URL=http://tournament-service:8008

# Media Service Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Subscription Service Configuration
SUBSCRIPTION_SERVICE_PORT=8012
SUBSCRIPTION_DB_USER=subscriptionuser
SUBSCRIPTION_DB_PASSWORD=subscriptionpass
SUBSCRIPTION_DB_NAME=subscriptiondb
SUBSCRIPTION_DB_PORT=5442

# Database URL for subscription-service
SUBSCRIPTION_DATABASE_URL=postgresql://subscriptionuser:subscriptionpass@postgres-subscription:5432/subscriptiondb?schema=public

# Subscription Service URL and Token
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8012

# VNPay Configuration (obtain from https://sandbox.vnpayment.vn for sandbox / VNPay merchant portal for production)
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Coach Service Configuration
COACH_SERVICE_PORT=8019
COACH_DB_USER=coachuser
COACH_DB_PASSWORD=coachpass
COACH_DB_NAME=coachdb
COACH_DB_PORT=5453
COACH_DATABASE_URL=postgresql://coachuser:coachpass@postgres-coach:5432/coachdb?schema=public
COACH_SERVICE_URL=http://coach-service:8019

# Chat Service Configuration
CHAT_SERVICE_PORT=8029
CHAT_DB_USER=chatuser
CHAT_DB_PASSWORD=chatpass
CHAT_DB_NAME=chatdb
CHAT_DB_PORT=5463
CHAT_DATABASE_URL=postgresql://chatuser:chatpass@postgres-chat:5432/chatdb?schema=public
CHAT_SERVICE_URL=http://chat-service:8029

# Expo Push Notifications (notification-service)
# Optional but strongly recommended for production (prevents token spoofing).
# Leave empty for development — push will work without it.
EXPO_ACCESS_TOKEN=

# Internal Service Authentication
# Shared token used for service-to-service API calls.
SERVICE_INTERNAL_TOKEN=your-super-secret-internal-service-token-change-this-in-production
